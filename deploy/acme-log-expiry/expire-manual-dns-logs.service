[Unit]
Description=Expire old manual DNS renewal logs
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/expire-manual-dns-logs
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/log
