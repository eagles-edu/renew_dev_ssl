# iNET OneShield origin allowlist. Verified against iNET's published list on
# 2026-10-11: https://developers.inet.vn/docs/oneportal/oneshield-danh-sach-ip
# Keep this in sync with /etc/nginx/snippets/oneshield-realip.conf.
# HTTP-01 is not needed here: both Let's Encrypt certificates use DNS-01.

# `destroy` makes reloading the file idempotent and replaces the table in one
# nftables transaction. This table is independent of iptables-nft managed rules.
destroy table inet renew_oneshield_origin

table inet renew_oneshield_origin {
    set oneshield_ipv4 {
        type ipv4_addr
        flags interval
        elements = {
            103.216.118.0/27,
            103.56.163.0/27,
            103.166.183.0/27,
            103.72.98.10,
            103.72.97.5,
            103.72.96.10
        }
    }

    set oneshield_ipv6 {
        type ipv6_addr
        flags interval
        elements = {
            2001:df7:ce00:19::3:0/112,
            2001:df7:ce00:16::3:0/112,
            2001:df7:ce00:22::3:0/112,
            2001:df0:1b:3::3:0,
            2001:df0:1b:2::3:0,
            2001:df0:1b:1::3:0
        }
    }

    chain input {
        type filter hook input priority -15; policy accept;

        # Filter only public NICs; container and loopback traffic stays local.
        iifname { "eth0", "eth1" } meta l4proto tcp tcp dport { 80, 443 } ip saddr != @oneshield_ipv4 counter drop
        iifname { "eth0", "eth1" } meta l4proto tcp tcp dport { 80, 443 } ip6 saddr != @oneshield_ipv6 counter drop
    }
}
