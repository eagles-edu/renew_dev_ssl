{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.experimental.useFlatConfig": true,
  "eslint.validate": ["javascript", "javascriptreact"],
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    },
    {
      "directory": ".",
      "changeProcessCWD": true
    }
  ],
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "cssvar.files": ["vhost-manager/ui/src/**/*.css"],
  "npm.packageManager": "npm",
  "prettier.configPath": ".prettierrc",
  "prettier.requireConfig": true,
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.shellArgs.linux": ["-l"],
  "terminal.integrated.env.linux": {
    "NVM_DIR": "/home/eagles/.nvm"
  },
  "cSpell.words": [
    "Apport",
    "checkpointed",
    "checkpointing",
    "checksummed",
    "codacy",
    "contextlib",
    "contextmanager",
    "CREC",
    "cutover",
    "cutovers",
    "dataclass",
    "dataclasses",
    "dbstat",
    "dnsutils",
    "docstrings",
    "EACCES",
    "eaglesvn",
    "ENOSPC",
    "executemany",
    "fcntl",
    "finalizer's",
    "finishable",
    "gcbf",
    "geteuid",
    "glpat",
    "GPTMD",
    "gsub",
    "importability",
    "inblk",
    "journalctl",
    "journaled",
    "linearization",
    "mktemp",
    "noall",
    "noninteractive",
    "nonterminal",
    "norecurse",
    "nosec",
    "NXDOMAIN",
    "oneshot",
    "ossl",
    "Precertificate",
    "prlimit",
    "PWDEBUG",
    "Pylint",
    "pyproject",
    "PYTHONPATH",
    "replayable",
    "rescan",
    "rescans",
    "resequence",
    "retriable",
    "RLIMIT",
    "savepoint",
    "SDEC",
    "sed",
    "SERVFAIL",
    "soa",
    "SOA",
    "subcases",
    "subrecords",
    "subtests",
    "suffixless",
    "syscall",
    "toplevel",
    "UDP",
    "unheld",
    "unkeyed",
    "unpurged",
    "vhost",
    "virtualenv",
    "webroots",
    "worktrees"
  ],
  "curatormdStatus.profile": "renew-ssl-coding",
  "curatormdStatus.pollSeconds": 25
}
