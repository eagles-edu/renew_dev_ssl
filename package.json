{
  "name": "renew_ssl",
  "version": "0.0.02.x",
  "private": true,
  "description": "Automation and validation toolkit for manual DNS ACME renewals plus hardened Playwright checks.",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:moodle-db": "./scripts/moodle-db-healthcheck.sh",
    "test": "playwright test",
    "test:strict": "PLAYWRIGHT_REQUIRE_SECURITY_HEADERS=1 playwright test",
    "test:debug": "PWDEBUG=1 playwright test --ui",
    "test:report": "playwright show-report",
    "pw:install": "playwright install chromium firefox webkit",
    "check": "npm run lint && npm run format:check && npm run test",
    "check:strict": "npm run lint && npm run format:check && npm run test:strict"
  },
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eagles-edu/renew_ssl.git"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/eagles-edu/renew_ssl/issues"
  },
  "homepage": "https://github.com/eagles-edu/renew_ssl#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "dotenv": "^17.2.4",
    "eslint": "^10.0.0",
    "globals": "^17.3.0",
    "prettier": "^3.8.1"
  }
}
